# Conference Transcription Bot — Environment Variables
# Copy this file to .env and fill in your keys

# Required: OpenAI API key for Whisper transcription
OPENAI_API_KEY=sk-...

# Required: Anthropic API key for Claude summarization
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Your display name shown in the conference
BOT_DISPLAY_NAME=Transcription Bot

# Optional: Default output directory for transcripts and summaries
OUTPUT_DIR=./sessions

# Optional: Audio chunk size in seconds (default: 30)
CHUNK_SECONDS=30

# Optional: Whisper model to use (whisper-1 via API, or local model name)
WHISPER_MODEL=whisper-1

# Optional: Claude model for summarization
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Google account credentials (for Google Meet auto-login)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Optional: Microsoft account credentials (for Teams auto-login)
MS_EMAIL=
MS_PASSWORD=

# Optional: Zoom credentials
ZOOM_EMAIL=
ZOOM_PASSWORD=
